{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "quiz",
    "outDir": "quiz",
    "noEmitOnError": true,
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false
  },
  "include": ["quiz/*.ts"],
  "exclude": ["quiz/app.js"]
}
